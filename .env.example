# Copy to .env and set real values
JWT_SECRET_KEY=replace_with_a_strong_secret_at_least_32_chars
# If using Supabase/Postgres provide the full connection URL below.
# Example (Supabase):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.abcdef.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/divinedb

# Supabase Storage (for the document generation feature)
# SUPABASE_URL is the project's REST/Storage API base, NOT the Postgres connection string above.
SUPABASE_URL=https://your-project.supabase.co
# Service role key bypasses Storage RLS - keep this out of source control, set only as a deploy-time secret.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=documents

# Aadhaar KYC verification - QR and Offline XML are signed with DIFFERENT UIDAI
# certificates, so each flow has its own env var. Both must be PEM-encoded,
# single-line with \n for line breaks. Source these from UIDAI's official channels
# only - never fabricate or reuse a certificate you are not certain is the genuine,
# current one. Without the relevant var set, that KYC endpoint returns 500;
# every other endpoint in the API is unaffected.
#
# UIDAI_QR_CERT_PEM: used by POST /kyc/aadhaar/qr/verify (Secure QR signing cert,
# e.g. UIDAI's "auth sign" certificate from https://uidai.gov.in).
UIDAI_QR_CERT_PEM="-----BEGIN CERTIFICATE-----\nreplace_with_official_uidai_qr_signing_certificate\n-----END CERTIFICATE-----"
# UIDAI_XML_CERT_PEM: used by POST /kyc/aadhaar/xml/verify (Offline e-KYC XML
# signing cert, e.g. UIDAI's "offline public key" certificate).
UIDAI_XML_CERT_PEM="-----BEGIN CERTIFICATE-----\nreplace_with_official_uidai_offline_xml_certificate\n-----END CERTIFICATE-----"