# Copy to .env and set real values
JWT_SECRET_KEY=replace_with_a_strong_secret_at_least_32_chars
# If using Supabase/Postgres provide the full connection URL below.
# Example (Supabase):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.abcdef.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/divinedb

# Supabase Storage (for the document generation feature)
# SUPABASE_URL is the project's REST/Storage API base, NOT the Postgres connection string above.
SUPABASE_URL=https://your-project.supabase.co
# Service role key bypasses Storage RLS - keep this out of source control, set only as a deploy-time secret.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=documents

# Aadhaar KYC verification - QR and Offline XML are signed with DIFFERENT UIDAI
# certificates, so each flow has its own env var. Source these from UIDAI's official
# channels only - never fabricate or reuse a certificate you are not certain is the
# genuine, current one. Without the relevant var set, that KYC endpoint returns 500;
# every other endpoint in the API is unaffected.
#
# Each var accepts ONE OR MORE concatenated PEM certificates (a bundle) - UIDAI does
# not publish a single canonical signing certificate per flow, and there's no reliable
# way to know in advance which of several candidate certificates a given real card was
# signed with. All candidates in the bundle are tried in order; verification succeeds
# if any one of them matches.
#
# UIDAI_QR_CERT_PEM: used by POST /kyc/aadhaar/qr/verify (Secure QR signing cert(s)).
UIDAI_QR_CERT_PEM="-----BEGIN CERTIFICATE-----\nreplace_with_official_uidai_qr_signing_certificate\n-----END CERTIFICATE-----"
# UIDAI_XML_CERT_PEM: used by POST /kyc/aadhaar/xml/verify (Offline e-KYC XML
# signing cert(s), e.g. UIDAI's "offline public key" certificate).
UIDAI_XML_CERT_PEM="-----BEGIN CERTIFICATE-----\nreplace_with_official_uidai_offline_xml_certificate\n-----END CERTIFICATE-----"

# Razorpay (payments) - both RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET come from the same
# Razorpay dashboard page (Settings > API Keys). The key ID is safe to expose to the
# frontend (it's returned by POST /payments/create-order); the secret must never leave
# this backend. Without both set, /payments/create-order and /payments/verify return 502.
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET: set when creating the webhook in the Razorpay dashboard
# (Settings > Webhooks) - the webhook URL registered there must point at THIS backend's
# own POST /payments/webhook, not the frontend. Without this set, that endpoint returns
# 502 and Razorpay's webhook deliveries will keep failing/retrying.
RAZORPAY_WEBHOOK_SECRET=replace_with_a_strong_random_webhook_secret

# AI Concierge Chatbot - Gemini is the primary reasoning/embedding provider, Groq is the
# fallback reasoning provider plus STT (speech-to-text) and the hallucination guardrail
# judge. Without these set, POST /chatbot/message returns 502.
GEMINI_API_KEY=replace_with_gemini_api_key
GROQ_API_KEY=replace_with_groq_api_key
# Optional per-call timeout overrides (seconds) - defaults are used if unset.
# GEMINI_TIMEOUT_SECONDS must be >= 10 - the Gemini SDK rejects a shorter deadline outright.
GEMINI_TIMEOUT_SECONDS=10
# 15s: openai/gpt-oss-120b is a reasoning model and can take a few seconds even with
# reasoning_format="hidden"; a turn can also chain 2-3 Groq calls (tool round + final
# answer + guardrail judge), so this needs headroom, not just a single-call budget.
GROQ_TIMEOUT_SECONDS=15
CHATBOT_GUARDRAIL_THRESHOLD=0.5

# Zoho CRM sync - chatbot leads and customer/broker signups are written to Postgres
# first (source of truth) and then best-effort mirrored into Zoho CRM. A Zoho outage
# or missing config NEVER fails or blocks the underlying Postgres-backed request; the
# sync is simply skipped and a warning is logged.
#
# ZOHO_CLIENT_KEY / ZOHO_SECRET_KEY come from a "Server-based Applications" connected
# app in the Zoho API Console (https://api-console.zoho.in for the .in data center used
# here) - NOT a Self Client, which has no live browser consent/redirect flow. When
# creating it, register ZOHO_REDIRECT_URI below as an authorized redirect URI.
#
# The refresh token is bootstrapped automatically - no manual curl needed:
#   1. Set ZOHO_CLIENT_KEY, ZOHO_SECRET_KEY, ZOHO_REDIRECT_URI, and a random
#      ZOHO_OAUTH_SETUP_TOKEN (all below) and deploy/run the app.
#   2. Visit GET {this backend's base URL}/admin/zoho/oauth/start?key=<ZOHO_OAUTH_SETUP_TOKEN>
#      in a browser and approve access with the Zoho account leads should go to.
#   3. Zoho redirects to /admin/zoho/oauth/callback, which exchanges the grant code
#      for a refresh token, activates it immediately for the running process, and
#      best-effort persists it durably: to a local .env file when one exists (dev), and
#      to Render's env vars via the Render API when RENDER_API_KEY/RENDER_SERVICE_ID
#      are set (below) - so it survives a restart/redeploy with zero manual step. If
#      neither persistence path is configured, copy the token the callback page shows
#      you into ZOHO_REFRESH_TOKEN in your host's env var dashboard yourself.
#      See DivineAPI/zoho_admin_api.py and
#      DivineService/service_zoho.py::complete_oauth_setup for exactly what this does.
ZOHO_CLIENT_KEY=replace_with_zoho_client_id
ZOHO_SECRET_KEY=replace_with_zoho_client_secret
ZOHO_REFRESH_TOKEN=replace_with_zoho_refresh_token
# Data center domains - use accounts.zoho.in/www.zohoapis.in for an India-region
# account, or accounts.zoho.com/www.zohoapis.com for the US/global data center, etc.
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.in
ZOHO_API_DOMAIN=www.zohoapis.in
# Must exactly match a redirect URI registered on the Zoho connected app.
ZOHO_REDIRECT_URI=https://your-backend-domain/admin/zoho/oauth/callback

# Optional - lets the Zoho OAuth callback above auto-persist ZOHO_REFRESH_TOKEN into
# THIS Render service's own env vars via the Render API, instead of you copy-pasting it.
# RENDER_API_KEY: Render dashboard -> Account Settings -> API Keys. NOTE: Render API keys
# are account-wide (not scoped to one service) - this key grants whoever holds it (and,
# at runtime, this app itself) the ability to read/modify every service in the account,
# not just this one. Only set this if you're comfortable with that tradeoff for the
# convenience of a fully automatic refresh-token bootstrap.
# RENDER_SERVICE_ID: found in this service's Render dashboard URL/Settings (looks like
# "srv-xxxxxxxxxxxxxxxxxxxx").
RENDER_API_KEY=replace_with_render_api_key
RENDER_SERVICE_ID=replace_with_render_service_id
# Random secret gating /admin/zoho/oauth/* (generate with e.g. `openssl rand -base64 24`)
# - without a matching ?key=/state=, those routes return 403.
ZOHO_OAUTH_SETUP_TOKEN=replace_with_a_random_secret